MOCK_CORE_BIND=127.0.0.1
MOCK_CORE_PORT=8080

PUID=1000
PGID=100
CUSTOM_USER=
PASSWORD=
AUTO_START_WECHAT=true
ENABLE_WECHAT_NIGHTLY_RESTART=false
WECHAT_NIGHTLY_STOP_TIME=23:30
WECHAT_NIGHTLY_START_TIME=01:30
ENABLE_WECHAT_AUTO_LOGIN=true
AUTO_LOGIN_DELAY=3
WECHAT_ACCOUNTS=
WECHAT_DEFAULT_ACCOUNT_ID=default
WECHAT_ACCOUNT_UID_BASE=20000
WECHAT_ACCOUNT_DISPLAY_MAP=
WECHAT_LEGACY_DEFAULT_ACCOUNT=true
AGENT_WECHAT_IMAGE=ghcr.io/thisnick/agent-wechat:0.11.15
AGENT_WECHAT_SHM_MB=512
AGENT_WECHAT_PULL_TIMEOUT=900
AGENT_WECHAT_LOGIN_TIMEOUT_MS=300000
# Browser-facing WeChat Hub Desktop Gateway. agent-wechat child port 6174
# remains Docker-internal and is never published to the host.
WECHAT_DESKTOP_GATEWAY_HOST_BIND=0.0.0.0
WECHAT_DESKTOP_GATEWAY_PORT=17892
WECHAT_DESKTOP_GATEWAY_SESSION_TTL=14400
WECHAT_DESKTOP_GATEWAY_MAX_WS_FRAME_MB=64
WECHAT_DESKTOP_GATEWAY_MAX_HTTP_MB=1024
# Optional TLS reverse-proxy advertisement. Keep the default HTTP values for
# direct LAN testing; set scheme=https plus the externally reachable host/port
# when the same /desktop/... route is terminated by HTTPS. Browsers require a
# secure context for full text/image clipboard access away from localhost.
WECHAT_DESKTOP_GATEWAY_PUBLIC_SCHEME=http
WECHAT_DESKTOP_GATEWAY_PUBLIC_HOST=
WECHAT_DESKTOP_GATEWAY_PUBLIC_PORT=
# Prefer a Selkies process attached to the account's existing AgentWechat
# Xvfb/WeChat. Set false to keep noVNC-only behavior. The optional image
# override is normally empty so the companion reuses the exact Runtime image.
WECHAT_SELKIES_ATTACH_ENABLED=true
WECHAT_SELKIES_ATTACH_IMAGE=
WECHAT_NATIVE_DRIVER_SOCKET=
SHM_SIZE=1gb
RUNTIME_HTTP_PORT=3000
RUNTIME_HTTPS_PORT=3001

CORE_BIND=127.0.0.1
CORE_PORT=8080
CORE_SYNC_INTERVAL=5
CORE_SEND_INTERVAL=1
CORE_REGISTRY_RELOAD_INTERVAL=1

EFB_PROFILE_DIR=./efb-profile

WECHAT_CONSOLE_BIND=127.0.0.1
WECHAT_CONSOLE_PORT=8078
WECHAT_DESKTOP_URL=
WECHAT_AGENT_URL=
EFB_MULTI_URL=

WECHAT_AGENT_BIND=127.0.0.1
WECHAT_AGENT_PORT=8091
WECHAT_AGENT_CONSUMER_ID=wechat-agent
WECHAT_AGENT_LLM_BASE_URL=
WECHAT_AGENT_LLM_MODEL=
WECHAT_AGENT_LLM_API_KEY=
WECHAT_AGENT_LLM_TEMPERATURE=
WECHAT_AGENT_LLM_MAX_TOKENS=
WECHAT_AGENT_LLM_TIMEOUT_SECONDS=
