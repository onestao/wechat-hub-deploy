# 参数用途、数据备份和 EFB 配置说明：CONFIGURATION.zh-CN.md
TZ=Asia/Shanghai
PUID=1000
PGID=100
PASSWORD=change-this-password

WECHAT_HUB_DATA=./data
WECHAT_HUB_NETWORK=wechat-hub-internal

RUNTIME_IMAGE=ghcr.io/onestao/wechat-hub-runtime:main
CORE_IMAGE=ghcr.io/onestao/wechat-hub-core:main
CONSOLE_IMAGE=ghcr.io/onestao/wechat-hub-console:main
EFB_IMAGE=ghcr.io/onestao/wechat-hub-efb-linux-wechat-slave:main
AGENT_WECHAT_IMAGE=ghcr.io/onestao/wechat-hub-agent-wechat:main

RUNTIME_HTTP_BIND=0.0.0.0
RUNTIME_HTTP_PORT=3000
RUNTIME_HTTPS_BIND=0.0.0.0
RUNTIME_HTTPS_PORT=3001
DESKTOP_GATEWAY_BIND=0.0.0.0
WECHAT_DESKTOP_GATEWAY_PORT=17892
CONSOLE_BIND=0.0.0.0
CONSOLE_PORT=8078
CORE_BIND=127.0.0.1
CORE_PORT=8080

AUTO_START_WECHAT=true
ENABLE_WECHAT_AUTO_LOGIN=true
WECHAT_ACCOUNTS=
WECHAT_DEFAULT_ACCOUNT_ID=default
WECHAT_LEGACY_DEFAULT_ACCOUNT=true
AGENT_WECHAT_SHM_MB=512
AGENT_WECHAT_PULL_TIMEOUT=900
WECHAT_SELKIES_ATTACH_ENABLED=true
RUNTIME_SHM_SIZE=1gb

CORE_SYNC_INTERVAL=5
CORE_SEND_INTERVAL=1
CORE_REGISTRY_RELOAD_INTERVAL=1

EFB_PROFILE_DIR=./efb-profile

# Reverse proxy/TLS users may set these to the browser-visible address.
WECHAT_DESKTOP_GATEWAY_PUBLIC_SCHEME=http
WECHAT_DESKTOP_GATEWAY_PUBLIC_HOST=
WECHAT_DESKTOP_GATEWAY_PUBLIC_PORT=
